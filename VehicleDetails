local function atualizarRefletividadePistas(novoValor)
	currentReflectance = math.clamp(novoValor, 0, 1)
	for i = #pecasPista, 1, -1 do
		local part = pecasPista[i]
		if part and part.Parent then part.Reflectance = currentReflectance else table.remove(pecasPista, i) end
	end
end
reflectInput.FocusLost:Connect(function()
	local num = tonumber(reflectInput.Text)
	if num then atualizarRefletividadePistas(num) end
end)

local function checarEAdicionarPista(descendant)
	if descendant:IsA("BasePart") and nomesAlvoPista[descendant.Name] then
		table.insert(pecasPista, descendant)
		descendant.Reflectance = currentReflectance
	end
end
for _, desc in pairs(Workspace:GetDescendants()) do checarEAdicionarPista(desc) end
Workspace.DescendantAdded:Connect(checarEAdicionarPista)


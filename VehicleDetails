local function criarBotaoAlternador(textoAtivado, textoDesativado, pos, estadoInicial, acao)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 26)
	btn.Position = pos
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	
	local estado = estadoInicial
	local function atualizarVisual()
		btn.Text = estado and textoAtivado or textoDesativado
		btn.BackgroundColor3 = estado and Color3.fromRGB(45, 140, 45) or Color3.fromRGB(160, 45, 45)
	end
	
	btn.MouseButton1Click:Connect(function()
		estado = not estado
		atualizarVisual()
		acao(estado)
	end)
	
	atualizarVisual()
	btn.Parent = contentFrame
	return btn
end


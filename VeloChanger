-- --- ATUALIZADOR DO CARRO (NICKNAME & SPAWN) ---
local vehiclesFolder = Workspace:WaitForChild("Vehicles", 10)

local function applyModificationsToCar(car)
	if not car or not car:IsA("Model") then return end

	local isMine = false
	if car.Name == player.Name then isMine = true end
	
	local ownerVal = car:FindFirstChild("Owner")
	if ownerVal and (ownerVal:IsA("StringValue") or ownerVal:IsA("ObjectValue")) and ownerVal.Value == player.Name then
		isMine = true
	end

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
			if hum.SeatPart:IsDescendantOf(car) then isMine = true end
		end
	end

	if isMine then
		currentCar = car
		if car.Name ~= player.Name then car.Name = player.Name end
		if ownerVal then ownerVal.Value = player.Name end

		local seat = car:FindFirstChild("VehicleSeat", true)
		if seat and seat:IsA("VehicleSeat") then
			local origOwner = seat:FindFirstChild("OriginalOwner")
			if origOwner then origOwner.Value = player.Name end

			local maxSpd = seat:FindFirstChild("MaxSpeed")
			if maxSpd then maxSpd.Value = currentSpeed end
		end

		for _, part in ipairs(car:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name == "PhysicalWheel" or part.Parent.Name:find("Wheel")) then
				part.CustomPhysicalProperties = PhysicalProperties.new(0.7, currentDrift, 0.5, 1, 1)
			end
		end
	end
end

RunService.Heartbeat:Connect(function()
	if vehiclesFolder then
		for _, car in ipairs(vehiclesFolder:GetChildren()) do
			applyModificationsToCar(car)
		end
	end
end)

if vehiclesFolder then
	vehiclesFolder.ChildAdded:Connect(function(child)
		task.wait(0.1)
		applyModificationsToCar(child)
	end)
end


-- --- SINCRONIZADORES DE NÚMEROS ---
local function updateSpeed(newSpeed)
	currentSpeed = math.max(0, newSpeed)
	boxSpeed.Text = tostring(currentSpeed)
end

local function updateDrift(newDrift)
	currentDrift = math.clamp(newDrift, 0, 2)
	boxDrift.Text = string.format("%.2f", currentDrift)
end

boxSpeed.FocusLost:Connect(function() updateSpeed(tonumber(boxSpeed.Text) or currentSpeed) end)
boxDrift.FocusLost:Connect(function() updateDrift(tonumber(boxDrift.Text) or currentDrift) end)
boxSpeedInc.FocusLost:Connect(function() speedIncrement = tonumber(boxSpeedInc.Text) or speedIncrement boxSpeedInc.Text = tostring(speedIncrement) end)
boxDriftInc.FocusLost:Connect(function() driftIncrement = tonumber(boxDriftInc.Text) or driftIncrement boxDriftInc.Text = tostring(driftIncrement) end)

btnSpeedPlus.MouseButton1Click:Connect(function() updateSpeed(currentSpeed + speedIncrement) end)

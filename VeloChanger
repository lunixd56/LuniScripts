btnDriftPlus.MouseButton1Click:Connect(function() updateDrift(currentDrift + driftIncrement) end)
btnDriftMinus.MouseButton1Click:Connect(function() updateDrift(currentDrift - driftIncrement) end)


-- --- CAPTURA DE TECLAS ---
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isBinding and bindTarget and bindButton then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			hotkeys[bindTarget] = input.KeyCode
			bindButton.Text = input.KeyCode.Name
			bindButton.BackgroundColor3 = ELEMENT_BG
			bindButton.TextColor3 = ACCENT_COLOR
			
			isBinding = false
			bindTarget = nil
			bindButton = nil
		end
		return
	end

	if gameProcessed then return end 

	if input.KeyCode == hotkeys.SpeedUp then
		updateSpeed(currentSpeed + speedIncrement)
	elseif input.KeyCode == hotkeys.SpeedDown then
		updateSpeed(currentSpeed - speedIncrement)
	elseif input.KeyCode == hotkeys.DriftUp then
		updateDrift(currentDrift + driftIncrement)
	elseif input.KeyCode == hotkeys.DriftDown then
		updateDrift(currentDrift - driftIncrement)
	end
end)
